### Prompt ###
autoload -U colors; colors

tmp_prompt="%{${fg[cyan]}%}(${HOST}) %#%{${reset_color}%} "
tmp_prompt2="%{${fg[cyan]}%}%_> %{${reset_color}%}"
tmp_rprompt="%1(v|%F{magenta}%1v%f|)%{${fg[green]}%}[%(5~,%-2~/.../%2~,%~)]%{${reset_color}%}"
