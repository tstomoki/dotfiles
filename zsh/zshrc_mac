# ------------------------------
# General Settings
# ------------------------------
export LANG=ja_JP.UTF-8
export LESSCHARSET=utf-8

## コマンド入力補完（Homebrew の fpath より前に compinit を実行）
if [ -f ~/.zsh/auto-fu.zsh ]; then
    source ~/.zsh/auto-fu.zsh
    function zle-line-init () {
        auto-fu-init
    }
    zle -N zle-line-init
    zstyle ':completion:*' completer _oldlist _complete
fi

# 親シェルから引き継いだ Homebrew の補完パスを compinit 前に除外
fpath=(${fpath:#/opt/homebrew/*})
fpath=(~/zsh-completions/src $fpath)
autoload -U compinit; compinit -u

# Homebrew 初期化（compinit の後に実行し _uv 等が補完に干渉しないようにする）
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [ -x /usr/local/bin/brew ]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

## cd 後自動で ls する
function chpwd() { ls; echo -ne "\033]0;$(pwd | rev | awk -F \/ '{print "/"$1"/"$2}'| rev)\007"}

## diff
alias difc='colordiff -w'
alias dify='diff -y --suppress-common-lines'
alias diff='colordiff'
alias less='less -R'

## tmux
alias tm='tmux -2'
alias tml='tmux ls'
alias tmk='tmux kill-session -t'
alias tma='tmux attach -t'

## command shortcuts
if command -v gls &>/dev/null; then
  alias ls='gls --color=auto --hide="*~"'
else
  alias ls='ls --color=auto'
fi
alias la='ls -la'
alias ctags='/usr/local/bin/ctags'
alias mysql='mysql --pager=cat'

## コマンド履歴
HISTFILE=~/.zsh_history
HISTSIZE=10000
SAVEHIST=10000
setopt hist_ignore_dups
setopt hist_ignore_all_dups
setopt hist_ignore_space
setopt hist_verify
setopt hist_reduce_blanks
setopt hist_save_no_dups
setopt hist_no_store
setopt hist_expand
setopt inc_append_history
setopt share_history

### for iTerm2 tabs
tab-color() {
    echo -ne "\033]6;1;bg;red;brightness;$1\a"
    echo -ne "\033]6;1;bg;green;brightness;$2\a"
    echo -ne "\033]6;1;bg;blue;brightness;$3\a"
}
tab-reset() {
    echo -ne "\033]6;1;bg;*;default\a"
}
alias top='tab-color 134 200 0; top; tab-reset'

function tab_yellow() { tab-color 255 255 0 }
function tab_blue()   { tab-color 0 0 255 }
function tab_red()    { tab-color 255 0 0 }
function rename_tab() { echo -ne "\033]0;$1\007" }
function sshc()       { tab-color 255 255 0; command ssh -A $1 }

