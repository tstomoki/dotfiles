### Google Cloud SDK ###
# $HOME/tmp/ または /usr/local/ 以下など柔軟に探す
_gcloud_path=""
for _p in \
  "$HOME/tmp/google-cloud-sdk" \
  "$HOME/google-cloud-sdk" \
  "/usr/local/Caskroom/google-cloud-sdk/latest/google-cloud-sdk"; do
  if [ -d "$_p" ]; then
    _gcloud_path="$_p"
    break
  fi
done
if [ -n "$_gcloud_path" ]; then
  [ -f "$_gcloud_path/path.zsh.inc" ]       && source "$_gcloud_path/path.zsh.inc"
  [ -f "$_gcloud_path/completion.zsh.inc" ] && source "$_gcloud_path/completion.zsh.inc"
  export CLOUDSDK_PYTHON="${PYENV_ROOT:-$HOME/.pyenv}/shims/python"
fi
unset _gcloud_path _p

### SSH ###
[ -f ~/.ssh/id_rsa ] && ssh-add ~/.ssh/id_rsa 2>/dev/null

### direnv ###
if command -v direnv &>/dev/null; then
  eval "$(direnv hook zsh)"
fi

# ------------------------------
# AI開発用レイアウト起動
# レイアウト:
#   +--------+---------+
#   |        |         |
#   | claude |  (空)   |
#   |        +---------+
#   |        |  (空)   |
#   +--------+---------+
# ------------------------------
function ai_dev() {
  local left_pane right_top right_bottom
  left_pane=$(tmux display-message -p '#{pane_id}')

  tmux split-window -h -p 50
  right_top=$(tmux display-message -p '#{pane_id}')

  tmux split-window -v -p 50
  right_bottom=$(tmux display-message -p '#{pane_id}')

  tmux select-pane -t "$left_pane"  -T "claude-code"
  tmux select-pane -t "$right_top"  -T "zsh1"
  tmux select-pane -t "$right_bottom" -T "zsh2"

  tmux select-pane -L
  tmux send-keys "claude" Enter
}

